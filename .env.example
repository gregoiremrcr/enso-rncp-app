# Copier dans .env et remplacer tous les placeholders avant le déploiement.
DOMAIN=your-domain.example

POSTGRES_DB=enso
POSTGRES_USER=enso_prod
# Générer un secret alphanumérique, par exemple avec : openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
DATABASE_URL=postgresql+psycopg://enso_prod:REPLACE_WITH_RANDOM_HEX_SECRET@db:5432/enso

FRONTEND_ORIGIN=https://your-domain.example
